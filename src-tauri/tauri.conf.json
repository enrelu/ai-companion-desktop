{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-companion-desktop",
  "version": "0.1.0",
  "identifier": "com.alcorce.ai-companion-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI Companion - Hub",
        "url": "index.html",
        "width": 660,
        "height": 620,
        "resizable": true,
        "center": true,
        "visible": true
      },
      {
        "label": "hud",
        "title": "AI Floating HUD",
        "url": "hud.html",
        "width": 570,
        "height": 360,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
